# Create a Supabase project, run the SQL from supabase/schema.sql, then add:
# The URL must include https:// and no surrounding quotes, e.g.
# https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the Supabase Publishable key (or the legacy anon key); never use a secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# Required for the optional Picnic connection.
# Use at least 32 random characters and configure this as a secret in Netlify.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PICNIC_SESSION_SECRET=replace-with-a-long-random-secret
